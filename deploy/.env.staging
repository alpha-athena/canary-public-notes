# staging settings for the notes service
# Secrets are NOT stored here: this file is tracked in git. Set PROVIDER_API_KEY
# in the deploy environment (Railway/Fly/Vercel variables, or the shell); notes.settings()
# overlays os.environ on top of this file, so the empty value below is filled at runtime.
NOTES_PORT=8080
NOTES_DB_HOST=db.staging.canary.invalid
PROVIDER_API_KEY=
